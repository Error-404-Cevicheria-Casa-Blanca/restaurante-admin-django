# Variables de entorno del panel Django (PE-6)
# Referencia de NOMBRES y valores de ejemplo. Python NO lee este archivo ni un
# `.env`: define cada variable en la sesión con `$env:NOMBRE = "valor"`.
# NUNCA subas valores reales al repositorio.

# Obligatoria si no se usa DJANGO_DEBUG=1. Genera una con:
#   .\.venv\Scripts\python.exe -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=falsa-clave-secreta-reemplazar-por-una-real

# "1" activa DEBUG (solo desarrollo local). Cualquier otro valor o vacío = DEBUG=False.
DJANGO_DEBUG=0

# Hosts permitidos, separados por coma.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Base de datos. Con las 5 definidas se usa PostgreSQL; con ninguna, SQLite
# local (db.sqlite3). Con solo algunas, el arranque falla avisando cuáles faltan.
DB_NAME=falsa_base
DB_USER=falso_usuario
DB_PASSWORD=falsa_clave
DB_HOST=localhost
DB_PORT=5432
